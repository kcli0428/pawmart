# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pawmart?schema=public"

# Auth.js
AUTH_SECRET="change-me-to-a-random-secret-in-production"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Stripe (Hong Kong — HKD)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Optional: protect /api/cron/crm
CRON_SECRET=""

# Email (Resend). If RESEND_API_KEY is empty, emails are logged / simulated.
RESEND_API_KEY=""
EMAIL_FROM="PawMart <noreply@pawmart.hk>"
ADMIN_ALERT_EMAIL="admin@pawmart.hk"

# Optional: Google Gemini fills missing ingredients/nutrition from Google Search.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=""
